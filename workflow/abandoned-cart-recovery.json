              "type": "string"
            },
            {
              "id": "a4",
              "name": "name",
              "value": "={{ $json.body?.customer?.first_name || $json.body?.billing_address?.first_name || $json.body?.shipping_address?.first_name || $json.name || \"there\" }}",
