# n8n
N8N_BASE_URL=https://your-instance.app.n8n.cloud

# Shopify (development store)
SHOPIFY_STORE_DOMAIN=slumdog-kl88zbxf.myshopify.com
SHOPIFY_WEBHOOK_CHECKOUT_PATH=/webhook/shopify/checkout-created
SHOPIFY_WEBHOOK_ORDER_PATH=/webhook/shopify/order-created
SHOPIFY_DISCOUNT_CODE=COMEBACK10
SHOPIFY_DISCOUNT_PERCENT=10

# Reminder timing (minutes). Demo: 2 / 3. Production: 60 / 1440
REMINDER_1_DELAY_MINUTES=2
REMINDER_2_DELAY_MINUTES=3

# Store branding used in messages
STORE_NAME=Slumdog

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# Model can be switched (e.g. Claude, Gemini, Groq) by changing the two AI nodes
AI_PROVIDER=openai

# Twilio WhatsApp (sandbox sender is +17372508034)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+17372508034

# Gmail (OAuth2 configured inside n8n)
GMAIL_SENDER_ADDRESS=you@example.com

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_TAB=Sheet1

# n8n stores credentials in its own credential store; these values document
# what each n8n credential needs and are never read from a committed file.
